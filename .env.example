APP_ENV=development
APP_TIMEZONE=UTC
APP_NAME="GPD Reporting Portal"
APP_BASE_URL=

SESSION_TIMEOUT=86400
SESSION_LIFETIME=86400
SESSION_SAMESITE=Lax
SESSION_COOKIE_PATH=/

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gpdreports
DB_USER=root
DB_PASS=

AUTO_MIGRATE=true
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Canonical hierarchy API (the sole source; cached server-side for availability)
HIERARCHY_API_URL=https://churches-api.rorportal.org/api/v1/hierarchy
HIERARCHY_CACHE_TTL=300
